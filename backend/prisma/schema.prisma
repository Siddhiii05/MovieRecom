model tbl_carousel5 {
  id                Int       @id
  title             String
  original_title    String?
  overview          String?
  backdrop_path     String?
  poster_path       String?
  media_type        String?
  original_language String?
  genre_ids         Int[]
  popularity        Float?
  release_date      DateTime?
  video             Boolean?
  vote_average      Float?
  vote_count        Int?
  adult             Boolean?
  created_at        DateTime  @default(now())
}