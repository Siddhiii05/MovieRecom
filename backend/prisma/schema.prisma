  video             Boolean?

  genre_ids         String?
}


model tbl_carousel2 {
  id                Int      @id
  title             String
  original_title    String
  overview          String   @db.Text
  backdrop_path     String?
  poster_path       String?
  media_type        String
  original_language String
  genre_ids         Json
  popularity        Float
  release_date      DateTime?
  video             Boolean
  vote_average      Float
  vote_count        Int
